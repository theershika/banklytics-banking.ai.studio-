# AccountPulse Environment Configuration (.env)
# Academic Project 16 — Banking Transaction Analysis System

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY="accountpulse-secret-key-change-in-production"

# MySQL 8.0 Database Configuration
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=banking_analysis

# Connection URI for SQLAlchemy
DATABASE_URL="mysql+pymysql://root:@localhost:3306/banking_analysis?charset=utf8mb4"

# Rule-Based Anomaly Detection Config
ANOMALY_HIGH_VALUE_THRESHOLD=25000.00
